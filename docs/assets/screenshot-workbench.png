<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" fill="none">
  <rect width="1200" height="675" rx="8" fill="#0f172a"/>
  <rect x="0" y="0" width="1200" height="45" fill="#1e293b"/>
  <text x="60" y="28" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#e2e8f0">🔥 SQL Workbench</text>
  <rect x="0" y="45" width="200" height="630" fill="#1e293b"/>
  <text x="20" y="80" font-family="Inter, sans-serif" font-size="12" font-weight="600" fill="#94a3b8">Schema Explorer</text>
  <text x="40" y="110" font-family="monospace" font-size="12" fill="#3b82f6">📋 users</text>
  <text x="40" y="135" font-family="monospace" font-size="12" fill="#3b82f6">📋 books</text>
  <text x="40" y="160" font-family="monospace" font-size="12" fill="#3b82f6">📋 loans</text>
  <rect x="200" y="45" width="1000" height="200" fill="#111827"/>
  <text x="230" y="80" font-family="monospace" font-size="13" fill="#c084fc">SELECT</text>
  <text x="300" y="80" font-family="monospace" font-size="13" fill="#e2e8f0">*</text>
  <text x="320" y="80" font-family="monospace" font-size="13" fill="#c084fc">FROM</text>
  <text x="375" y="80" font-family="monospace" font-size="13" fill="#e2e8f0">information_schema.tables;</text>
  <rect x="200" y="245" width="1000" height="430" fill="#0f172a"/>
  <text x="600" y="460" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" fill="#475569">Run a query to see results</text>
  <rect x="1080" y="50" width="100" height="30" rx="6" fill="#3b82f6"/>
  <text x="1130" y="70" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" font-weight="600" fill="white">▶ Run Query</text>
  <text x="600" y="650" text-anchor="middle" font-family="Inter, sans-serif" font-size="11" fill="#475569">📸 Replace with actual screenshot: navigate to /workbench and capture</text>
</svg>
